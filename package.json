{
  "name": "imovies",
  "version": "1.0.0",
  "description": "IMovies - Full-Stack MERN Movie Ticket Booking Application",
  "main": "api/index.js",
  "scripts": {
    "server": "nodemon server/server.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed": "node server/seeder.js -i",
    "seed:destroy": "node server/seeder.js -d",
    "test:concurrency": "node server/tests/concurrencyTest.js",
    "test:e2e": "node server/tests/e2eTest.js",
    "build": "npm --prefix client run build",
    "start": "node server/server.js"
  },
  "keywords": [
    "mern",
    "movie-booking",
    "react",
    "express",
    "mongodb",
    "serverless",
    "vercel"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
}
